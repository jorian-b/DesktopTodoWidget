<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="ReminderDialogWindowStyle" TargetType="Window">
        <Setter Property="Background" Value="#F3F5F8"/>
        <Setter Property="Foreground" Value="#202938"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
    </Style>

    <Style x:Key="ReminderDialogCardStyle" TargetType="Border">
        <Setter Property="Background" Value="#FFFFFF"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Padding" Value="24"/>
        <Setter Property="Margin" Value="10"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.16"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ReminderDialogTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="21"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#192536"/>
    </Style>

    <Style x:Key="ReminderDialogTaskNameStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="#68778A"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="Margin" Value="0,4,0,0"/>
    </Style>

    <Style x:Key="ReminderDialogSectionStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="#748196"/>
    </Style>

    <Style x:Key="ReminderDialogHintStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="#778397"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="ReminderDialogErrorStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="#B42318"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="ReminderDialogInputStyle" TargetType="TextBox">
        <Setter Property="Height" Value="38"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Background" Value="#F8FAFC"/>
        <Setter Property="Foreground" Value="#202938"/>
        <Setter Property="BorderBrush" Value="#D8E0EA"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style x:Key="ReminderDialogDatePickerStyle" TargetType="DatePicker">
        <Setter Property="Height" Value="38"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Background" Value="#F8FAFC"/>
        <Setter Property="Foreground" Value="#202938"/>
        <Setter Property="BorderBrush" Value="#D8E0EA"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style x:Key="ReminderDialogComboBoxStyle" TargetType="ComboBox">
        <Setter Property="Height" Value="38"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Background" Value="#F8FAFC"/>
        <Setter Property="Foreground" Value="#202938"/>
        <Setter Property="BorderBrush" Value="#D8E0EA"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style x:Key="ReminderWeekdayStyle" TargetType="CheckBox">
        <Setter Property="Margin" Value="0,0,8,8"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="#526074"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Pill"
                            Background="#F4F6F9"
                            BorderBrush="#DCE3EC"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="8,9">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Pill" Property="Background" Value="#E4F3EE"/>
                            <Setter TargetName="Pill" Property="BorderBrush" Value="#39A887"/>
                            <Setter Property="Foreground" Value="#08765B"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Pill" Property="BorderBrush" Value="#39A887"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Pill" Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ReminderDialogSecondaryButtonStyle" TargetType="Button">
        <Setter Property="MinWidth" Value="84"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="Padding" Value="14,6"/>
        <Setter Property="Background" Value="#F1F4F8"/>
        <Setter Property="Foreground" Value="#48566A"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style x:Key="ReminderDialogPrimaryButtonStyle" TargetType="Button"
           BasedOn="{StaticResource ReminderDialogSecondaryButtonStyle}">
        <Setter Property="MinWidth" Value="126"/>
        <Setter Property="Background" Value="#168A6A"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
</ResourceDictionary>
