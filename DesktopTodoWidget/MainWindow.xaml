<Window x:Class="DesktopTodoWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="DesktopTodoWidget.ico"
        Title="Todo"
        Width="340"
        Height="500"
        MinWidth="280"
        MinHeight="260"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="False"
        ShowInTaskbar="False">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" 
                      ResizeBorderThickness="8" 
                      CornerRadius="0" 
                      GlassFrameThickness="0" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="MainRoot" Margin="6" MouseEnter="MainRoot_MouseEnter" MouseLeave="MainRoot_MouseLeave">
        <!-- Background -->
        <Border x:Name="BackgroundSurface" CornerRadius="8" Background="#CC1A1A1A" Opacity="0">
        </Border>

        <!-- Main Content -->
        <Border x:Name="MainFrame" CornerRadius="8" BorderBrush="Transparent" BorderThickness="1" Background="Transparent" Padding="12">
            <Grid x:Name="TaskContentGrid"
                  SizeChanged="TaskContentGrid_SizeChanged"
                  Loaded="TaskContentGrid_Loaded">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <DockPanel x:Name="HeaderPanel" LastChildFill="False" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                        <ToggleButton x:Name="LockToggle"
                                      Width="32"
                                      Height="32"
                                      Margin="0,0,8,0"
                                      Visibility="Collapsed"
                                      Checked="LockToggle_Click"
                                      Unchecked="LockToggle_Click"
                                      Style="{StaticResource LockButtonStyle}">
                            <ToggleButton.Content>
                                <TextBlock Text="&#xE785;" x:Name="LockIcon" FontFamily="Segoe MDL2 Assets" FontSize="16"/>
                            </ToggleButton.Content>
                        </ToggleButton>

                        <ToggleButton x:Name="PinToggle"
                                      Width="32"
                                      Height="32"
                                      Margin="0,0,8,0"
                                      Visibility="Collapsed"
                                      Checked="PinToggle_Click"
                                      Unchecked="PinToggle_Click"
                                      ToolTip="Keep on top"
                                      ToolTipService.InitialShowDelay="150"
                                      Style="{StaticResource PinButtonStyle}">
                            <ToggleButton.Content>
                                <TextBlock Text="&#xE718;"
                                           x:Name="PinIcon"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="16"
                                           RenderTransformOrigin="0.5,0.5">
                                    <TextBlock.RenderTransform>
                                        <RotateTransform Angle="0"/>
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                            </ToggleButton.Content>
                        </ToggleButton>

                        <ToggleButton x:Name="HoverVisibilityToggle"
                                      Width="32"
                                      Height="32"
                                      Margin="0,0,8,0"
                                      Visibility="Collapsed"
                                      Checked="HoverVisibilityToggle_Click"
                                      Unchecked="HoverVisibilityToggle_Click"
                                      Style="{StaticResource PinButtonStyle}">
                            <ToggleButton.Content>
                                <Grid Width="18" Height="18">
                                    <TextBlock x:Name="HoverVisibilityIcon"
                                               Text="&#xE890;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="16"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                    <Path x:Name="HoverVisibilitySlash"
                                          Data="M 3,3 L 15,15"
                                          Stroke="#A0A0A0"
                                          StrokeThickness="2"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Visibility="Visible"/>
                                </Grid>
                            </ToggleButton.Content>
                        </ToggleButton>
                        
                        <Button x:Name="CloseButton"
                            Content="✕"
                                Width="32"
                                Height="32"
                                Click="Close_Click"
                                Style="{StaticResource CloseButtonStyle}"/>
                    </StackPanel>
                </DockPanel>

                <!-- Input Field -->
                <TextBox x:Name="TaskInput"
                         Grid.Row="1"
                         Height="40"
                         Margin="0,0,0,8"
                         Padding="10,8"
                         Visibility="Collapsed"
                         KeyDown="TaskInput_KeyDown"
                         LostFocus="TaskInput_LostFocus"
                         Background="#2A2A2A"
                         Foreground="White"
                         CaretBrush="White"
                         BorderThickness="1"
                         BorderBrush="#44FFFFFF"
                         FontSize="14"
                         VerticalContentAlignment="Center"
                         WindowChrome.IsHitTestVisibleInChrome="True"/>

                <!-- Task List -->
                <ListBox x:Name="TaskList"
                         Grid.Row="2"
                         MaxHeight="0"
                         AllowDrop="True"
                         PreviewMouseMove="TaskList_PreviewMouseMove"
                         Drop="TaskList_Drop"
                         WindowChrome.IsHitTestVisibleInChrome="True">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                                <Border CornerRadius="6"
                                    Padding="8"
                                    Margin="0,0,0,6"
                                        BorderThickness="1"
                                        Background="#01000000"
                                        BorderBrush="Transparent"
                                        Tag="TaskCard"
                                        Loaded="TaskCard_Loaded"
                                        ContextMenuOpening="TaskCard_ContextMenuOpening">
                                <Border.ContextMenu>
                                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                        <MenuItem Header="Set date, reminder and repeat..." Click="Reminder_Click"/>
                                        <MenuItem Header="Test alarm" Click="TestAlarm_Click"/>
                                        <MenuItem Header="Clear alarm" Click="ClearAlarm_Click"/>
                                        <Separator/>
                                        <MenuItem Header="Urgent"
                                                  IsCheckable="True"
                                                  IsChecked="{Binding IsUrgent, Mode=TwoWay}"
                                                  Click="UrgentToggle_Click"/>
                                        <MenuItem Header="Restore"
                                                  Click="RestoreTask_Click">
                                            <MenuItem.Style>
                                                <Style TargetType="MenuItem">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasPendingRemoval}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </MenuItem.Style>
                                        </MenuItem>
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Grid Width="24" Height="24" Margin="0,0,12,0">
                                        <CheckBox x:Name="TaskCheckBox"
                                                  IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                  Style="{StaticResource TaskAwareCheckBoxStyle}"
                                                  VerticalAlignment="Center"
                                                  Checked="Checkbox_Changed"
                                                  Unchecked="Checkbox_Changed"
                                                  WindowChrome.IsHitTestVisibleInChrome="True"/>
                                        <TextBlock Text="&#xE823;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   Foreground="#00C896"
                                                   FontSize="16"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsTimer}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="!"
                                                   Foreground="#FFFF5C5C"
                                                   FontSize="17"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Top"
                                                   IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsUrgent}" Value="True"/>
                                                                <Condition Binding="{Binding IsChecked}" Value="False"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </MultiDataTrigger>
                                                        <DataTrigger Binding="{Binding ElementName=TaskCheckBox, Path=IsMouseOver}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>

                                    <Grid Grid.Column="1">
                                        <TextBox Text="{Binding Text}"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 Foreground="White"
                                                 TextWrapping="Wrap"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 MinWidth="0"
                                                 FontSize="15"
                                                 VerticalAlignment="Center"
                                                 CaretBrush="White"
                                                 WindowChrome.IsHitTestVisibleInChrome="True">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsTimer}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                        <TextBlock Text="{Binding TimerDisplay}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock"
                                                       BasedOn="{StaticResource TimerCountdownTextStyle}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsTimer}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>

                                    <TextBlock Grid.Row="1"
                                               Grid.Column="1"
                                               Text="{Binding DueAt, StringFormat={}{0:MMM d, HH:mm}}"
                                               Foreground="#B8FFFFFF"
                                               FontSize="11"
                                               Margin="0,4,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DueAt}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsTimer}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                        <Button Grid.Column="2"
                                                Grid.RowSpan="2"
                                                Content="◷"
                                                Click="Reminder_Click"
                                                ToolTip="{Binding ReminderToolTip}"
                                                ToolTipService.InitialShowDelay="150"
                                                Style="{StaticResource AlarmIndicatorStyle}"
                                                WindowChrome.IsHitTestVisibleInChrome="True"/>

                                        <TextBlock Grid.Column="3"
                                                   Grid.RowSpan="2"
                                                   Text="&#xE74D;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   Foreground="#B8FFFFFF"
                                                   FontSize="15"
                                                   VerticalAlignment="Center"
                                                   Margin="4,0"
                                                   ToolTip="{Binding DiscardToolTip}"
                                                   ToolTipService.InitialShowDelay="150">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DiscardAt}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                                        <Button Grid.Column="4"
                                            Content="✕"
                                            Width="24"
                                            Height="24"
                                            Grid.RowSpan="2"
                                            Click="Delete_Click"
                                            ToolTip="{Binding DeleteToolTip}"
                                            ToolTipService.InitialShowDelay="150"
                                            Style="{StaticResource DeleteButtonStyle}"
                                            WindowChrome.IsHitTestVisibleInChrome="True"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Grid.Row="2"
                        Margin="0,0,0,6"
                        Padding="8,4"
                        CornerRadius="6"
                        BorderThickness="1"
                        BorderBrush="#38FFFFFF"
                        Background="#80000000"
                        Opacity="0.3"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ElementName=TaskList, Path=HasItems}" Value="False">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock x:Name="EmptyStateText"
                               Text="TODO"
                               Foreground="White"
                               FontSize="11"
                               HorizontalAlignment="Right"
                               TextAlignment="Right"/>
                </Border>

                <!-- Footer with Add Button -->
                <StackPanel Grid.Row="3"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,6,0,0">
                    <Button x:Name="TimerButton"
                            Width="36"
                            Height="36"
                            Visibility="Collapsed"
                            Click="TimerButton_Click"
                            ToolTip="Start a timer"
                            ToolTipService.InitialShowDelay="150"
                            Style="{StaticResource TimerButtonStyle}"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                        <Path Width="24"
                              Height="24"
                              Data="M12,1.5 A10.5,10.5 0 1 0 12,22.5 A10.5,10.5 0 1 0 12,1.5 M12,5.5 L12,12 L16.5,14.5"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.8"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              Stretch="Uniform"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                    </Button>
                    <Button x:Name="AddButton"
                            Height="36"
                            Width="36"
                            Margin="4,0,0,0"
                            Visibility="Collapsed"
                            Click="AddTask_Click"
                            ToolTip="Add task"
                            ToolTipService.InitialShowDelay="150"
                            Style="{StaticResource AddButtonStyle}"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                        <Path Width="24"
                              Height="24"
                              Data="M12,4 L12,20 M4,12 L20,12"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="2"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Stretch="Uniform"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>

                <Popup x:Name="TimerPopup"
                       PlacementTarget="{Binding ElementName=TimerButton}"
                       Placement="Top"
                       StaysOpen="False"
                       AllowsTransparency="True"
                       PopupAnimation="Fade"
                       Closed="TimerPopup_Closed">
                    <Border Style="{StaticResource TimerPopupCardStyle}">
                        <StackPanel>
                            <TextBlock Text="START A TIMER"
                                       Style="{StaticResource TimerPopupTitleStyle}"/>
                            <TextBlock Text="Choose a preset or enter minutes."
                                       Style="{StaticResource TimerPopupHintStyle}"/>
                            <UniformGrid Columns="3" Rows="2" Margin="0,12,0,8">
                                <Button Content="2 min" Tag="2" Click="TimerPreset_Click" Style="{StaticResource TimerPresetButtonStyle}"/>
                                <Button Content="5 min" Tag="5" Click="TimerPreset_Click" Style="{StaticResource TimerPresetButtonStyle}"/>
                                <Button Content="15 min" Tag="15" Click="TimerPreset_Click" Style="{StaticResource TimerPresetButtonStyle}"/>
                                <Button Content="30 min" Tag="30" Click="TimerPreset_Click" Style="{StaticResource TimerPresetButtonStyle}"/>
                                <Button Content="1 hour" Tag="60" Click="TimerPreset_Click" Style="{StaticResource TimerPresetButtonStyle}"/>
                                <Button Content="2 hours" Tag="120" Click="TimerPreset_Click" Style="{StaticResource TimerPresetButtonStyle}"/>
                            </UniformGrid>
                            <TextBox x:Name="TimerMinutesInput"
                                     Style="{StaticResource TimerMinutesInputStyle}"
                                     MaxLength="7"
                                     ToolTip="Duration in minutes"
                                     ToolTipService.InitialShowDelay="150"/>
                            <TextBlock Text="Custom duration in minutes"
                                       Style="{StaticResource TimerPopupHintStyle}"
                                       Margin="2,4,0,10"/>
                            <TextBlock x:Name="TimerValidationText"
                                       Style="{StaticResource TimerPopupErrorStyle}"
                                       Visibility="Collapsed"/>
                            <Button Content="Start timer"
                                    Click="StartTimer_Click"
                                    Style="{StaticResource TimerStartButtonStyle}"/>
                            <Button Content="Cancel"
                                    Click="CancelTimer_Click"
                                    Style="{StaticResource TimerCancelButtonStyle}"/>
                        </StackPanel>
                    </Border>
                </Popup>

                <Grid x:Name="TaskSetBar"
                      Grid.Row="5"
                      Visibility="Collapsed"
                      Margin="0,4,0,0"
                      WindowChrome.IsHitTestVisibleInChrome="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="DeleteTaskGroupButton"
                            Content="&#xE74D;"
                            FontFamily="Segoe MDL2 Assets"
                            Width="36"
                            Height="36"
                            Visibility="Collapsed"
                            Click="DeleteTaskGroup_Click"
                            ToolTip="Delete empty group"
                            ToolTipService.InitialShowDelay="150"
                            Style="{StaticResource DeleteButtonStyle}"
                            WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <ComboBox x:Name="TaskSetSelector"
                              Grid.Column="1"
                              SelectionChanged="TaskSetSelector_SelectionChanged"
                              DropDownClosed="TaskSetSelector_DropDownClosed"
                              Style="{StaticResource TaskSetSelectorStyle}"
                              ItemContainerStyle="{StaticResource TaskSetSelectorItemStyle}"
                              WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Grid.Column="2"
                            Content="+"
                            Width="36"
                            Height="36"
                            Click="AddTaskGroup_Click"
                            ToolTip="Add task group"
                            ToolTipService.InitialShowDelay="150"
                            Style="{StaticResource AddButtonStyle}"
                            WindowChrome.IsHitTestVisibleInChrome="True"/>
                </Grid>
            </Grid>
        </Border>

        <Grid x:Name="AlarmOverlay" Visibility="Collapsed" Panel.ZIndex="10">
            <Border Background="#F21A1A1A"
                    BorderBrush="#55FFFFFF"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="24">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Stretch">
                    <TextBlock Text="ALARM"
                               Foreground="#00C896"
                               FontSize="13"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,14"/>
                    <TextBlock x:Name="AlarmTaskText"
                               Foreground="White"
                               FontSize="25"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               HorizontalAlignment="Stretch"/>
                    <TextBlock x:Name="AlarmDetailText"
                               Foreground="#D0FFFFFF"
                               FontSize="14"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               HorizontalAlignment="Stretch"
                               Margin="0,12,0,22"/>
                    <Button Content="Dismiss"
                            Width="88"
                            Height="34"
                            HorizontalAlignment="Center"
                            Click="DismissAlarm_Click"
                            Style="{StaticResource ProfessionalButtonStyle}"
                            WindowChrome.IsHitTestVisibleInChrome="True"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>