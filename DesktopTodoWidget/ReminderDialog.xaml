<Window x:Class="DesktopTodoWidget.ReminderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Task reminder"
        Width="440"
        SizeToContent="Height"
        MinHeight="500"
        MaxHeight="760"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Style="{DynamicResource ReminderDialogWindowStyle}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="7"
                      CornerRadius="0"
                      GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ReminderDialogStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Style="{StaticResource ReminderDialogCardStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Margin="0,0,0,18"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown"
                  WindowChrome.IsHitTestVisibleInChrome="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Schedule task"
                               Style="{StaticResource ReminderDialogTitleStyle}"/>
                    <TextBlock x:Name="TaskName"
                               Style="{StaticResource ReminderDialogTaskNameStyle}"/>
                </StackPanel>
                <Button Grid.Column="1"
                        Content="&#xE8BB;"
                        FontFamily="Segoe MDL2 Assets"
                        Style="{StaticResource ReminderDialogCloseButtonStyle}"
                        Click="CloseButton_Click"
                        ToolTip="Close"
                        ToolTipService.InitialShowDelay="150"
                        WindowChrome.IsHitTestVisibleInChrome="True"/>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="DATE AND TIME"
                               Style="{StaticResource ReminderDialogSectionStyle}"/>
                    <Grid Margin="0,8,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <Button x:Name="DateButton"
                                    Click="DateButton_Click"
                                    Style="{StaticResource ReminderDialogDateButtonStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE787;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="14"
                                               Foreground="#168A6A"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0"/>
                                    <TextBlock x:Name="DateText"
                                               Grid.Column="1"
                                               Foreground="#F2F5F8"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2"
                                               Text="&#xE70D;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="10"
                                               Foreground="#929DAA"
                                               VerticalAlignment="Center"
                                               Margin="10,0,0,0"/>
                                </Grid>
                            </Button>
                            <Popup x:Name="CalendarPopup"
                                   PlacementTarget="{Binding ElementName=DateButton}"
                                   Placement="Bottom"
                                   StaysOpen="False"
                                   AllowsTransparency="True"
                                   PopupAnimation="Fade">
                                <Border Style="{StaticResource ReminderCalendarPopupStyle}">
                                    <Calendar x:Name="DueCalendar"
                                              SelectedDatesChanged="DueCalendar_SelectedDatesChanged"
                                              Style="{StaticResource ReminderCalendarStyle}"/>
                                </Border>
                            </Popup>
                        </Grid>
                        <TextBox x:Name="TimeInput"
                                 Grid.Column="2"
                                 MaxLength="5"
                                 VerticalContentAlignment="Center"
                                 Style="{StaticResource ReminderDialogTimeInputStyle}"
                                 ToolTip="24-hour time, for example 09:30"
                                 ToolTipService.InitialShowDelay="150"/>
                    </Grid>

                    <TextBlock Text="ALERT"
                               Style="{StaticResource ReminderDialogSectionStyle}"/>
                    <ComboBox x:Name="AlertChoice"
                              Margin="0,8,0,18"
                              Style="{StaticResource ReminderDialogComboBoxStyle}"
                              SelectedValuePath="Tag"/>

                    <TextBlock Text="REPEAT"
                               Style="{StaticResource ReminderDialogSectionStyle}"/>
                    <ComboBox x:Name="RecurrenceChoice"
                              Margin="0,8,0,4"
                              Style="{StaticResource ReminderDialogComboBoxStyle}"
                              SelectedValuePath="Tag"
                              SelectionChanged="RecurrenceChoice_SelectionChanged"/>
                    <TextBlock x:Name="RecurrenceHelp"
                               Style="{StaticResource ReminderDialogHintStyle}"
                               Margin="0,0,0,12"/>

                    <StackPanel x:Name="WeekdaysPanel" Visibility="Collapsed">
                        <TextBlock Text="REPEAT ON"
                                   Style="{StaticResource ReminderDialogSectionStyle}"
                                   Margin="0,4,0,8"/>
                        <UniformGrid Columns="4" Rows="2">
                            <CheckBox Content="Mon" Tag="Monday" Style="{StaticResource ReminderWeekdayStyle}"/>
                            <CheckBox Content="Tue" Tag="Tuesday" Style="{StaticResource ReminderWeekdayStyle}"/>
                            <CheckBox Content="Wed" Tag="Wednesday" Style="{StaticResource ReminderWeekdayStyle}"/>
                            <CheckBox Content="Thu" Tag="Thursday" Style="{StaticResource ReminderWeekdayStyle}"/>
                            <CheckBox Content="Fri" Tag="Friday" Style="{StaticResource ReminderWeekdayStyle}"/>
                            <CheckBox Content="Sat" Tag="Saturday" Style="{StaticResource ReminderWeekdayStyle}"/>
                            <CheckBox Content="Sun" Tag="Sunday" Style="{StaticResource ReminderWeekdayStyle}"/>
                        </UniformGrid>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Margin="0,16,0,0">
                <TextBlock x:Name="ValidationMessage"
                           Style="{StaticResource ReminderDialogErrorStyle}"
                           Visibility="Collapsed"/>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,12,0,0">
                    <Button Content="Cancel"
                            IsCancel="True"
                            Style="{StaticResource ReminderDialogSecondaryButtonStyle}"/>
                    <Button Content="Save reminder"
                            IsDefault="True"
                            Click="SaveButton_Click"
                            Style="{StaticResource ReminderDialogPrimaryButtonStyle}"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
